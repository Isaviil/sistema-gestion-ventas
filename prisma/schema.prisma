// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id_usu         Int      @id @default(autoincrement())
  username       String   @unique
  password       String
  nombres        String
  apellidos      String
  email          String?  @unique
  rol            Role     @default(USER)
  flg_activo     Boolean  @default(true)
  fec_reg        DateTime @default(now())
  fec_ult_login  DateTime?
}

enum Role {
  ADMIN
  USER
}

model PaymentMethod {
  for_pago    Int     @id @default(autoincrement())
  forma_pago  String
  codigo      String? @unique
  dias        Int     @default(0)
  flg_activo  Boolean @default(true)
}

model Customer {
  id_aux       Int      @id @default(autoincrement())
  des_aux      String
  tipo_pers    Int?
  tdoc_ide     String?
  ruc_aux      String?  @unique
  dir_legal    String?
  referencia   String?
  telefono     String?
  email        String?
  ubigeo       String
  departamento String
  provincia    String
  distrito     String
  id_ven       Int
  vendedor     Vendor   @relation(fields: [id_ven], references: [id_aux])
  for_pago     Int?
  id_tpoclie   Int
  fec_reg      DateTime @default(now())
  flg_activo   Boolean  @default(true)
}

model Vendor {
  id_aux     Int        @id @default(autoincrement())
  cod_ven    String     @unique
  nom_aux    String
  ape_aux    String
  ape_mat    String
  tdoc_ide   String
  ndoc_ide   String
  cel_job    String
  email_job  String
  fec_reg    DateTime   @default(now())
  flg_baja   Boolean    @default(false)
  flg_tda    Boolean    @default(false)
  basico     Decimal    @default(0)
  id_area    Int

  customers  Customer[]
}

model Ubigeo {
  id          Int    @id @default(autoincrement())
  codigo      String @unique
  departamento String
  provincia   String
  distrito    String
}

model Product {
  id_art       Int      @id @default(autoincrement())
  cod_art      String   @unique
  des_art      String
  des_art2     String?

  stkact       Int      @default(0)
  peso         Decimal? @default(0)

  pre_art      Decimal  @default(0)
  pv2          Decimal? @default(0)
  pv3          Decimal? @default(0)
  pv4          Decimal? @default(0)

  id_umedr     Int?
  id_fam       Int?
  id_corte     Int?
  id_mar       Int?
  id_color     Int?
  id_talla     Int?

  flg_activo   Boolean  @default(true)
}

model Currency {
  codmon      String  @id
  descrip     String
  flg_activo  Boolean @default(true)
}

model ExchangeRate {
  id_tcmb  String   @id
  fchcmb   DateTime
  oficmp   Decimal
  ofivta   Decimal
}

model DocumentType {
  id_tipdoc  Int     @id @default(autoincrement())
  alias_alm  String?
  flg_sunat  Boolean @default(false)
  codsunat   String?
  dcor_tdoc  String
  dlar_tdoc  String
  flg_vta    Boolean @default(false)
  flg_alm    Boolean @default(false)
  flg_provi  Boolean @default(false)
}

model UnitOfMeasure {
  id_umed    Int     @id
  des_umed   String
  alias_umed String
  codigo     String
  reservado  Boolean @default(false)
}

model ProductFamily {
  id_fam  Int    @id
  familia String
  codigo  String
}

model ProductCut {
  id_corte Int    @id
  corte    String
}

model Brand {
  id_mar Int    @id
  marca  String
  codigo String
}

model ProductColor {
  id_color Int    @id
  color    String
}

model ProductSize {
  id_talla Int    @id
  talla    String
}

model Vehicle {
  id_vehi      Int    @id @default(autoincrement())
  placa        String
  marca        String
  certificado  String?
}

model Almacen {
  codalm      Int      @id @default(autoincrement())
  aliasalm    String
  desalm      String
  diralm      String?
  departam    String
  provincia   String
  distrito    String
  ubigeo      String
  kanexo      String
  telefalm    String?
  logoalm     String?
  flg_stock   Boolean  @default(false)
  flg_acu     Boolean  @default(false)
  usuario     Int
  fch_reg     DateTime @default(now())
  flg_ok      Boolean  @default(true)
  reservado   Boolean  @default(false)
}

model Chofer {
  id_chof  Int    @id @default(autoincrement())
  brevete  String @unique
  dni      String @unique
  nombre   String
}